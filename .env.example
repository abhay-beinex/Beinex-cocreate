# Local development: call the model API directly with your key (never do this for a release build).
VITE_OPENROUTER_API_KEY=

# Release: leave the key empty and point the app at the proxy in server/proxy.mjs, which holds the key.
# VITE_MODEL_API_BASE=/api/v1
# VITE_PROXY_TOKEN=same-long-random-string-as-PROXY_TOKEN-on-the-server
